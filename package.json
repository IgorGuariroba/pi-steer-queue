{
  "name": "pi-steer-queue",
  "version": "0.1.0",
  "description": "Type ahead while pi works: Enter queues, Enter again steers at the next safe point, Enter once more interrupts and sends now.",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "pi-package",
    "pi",
    "steer",
    "queue",
    "follow-up",
    "interrupt"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/IgorGuariroba/pi-steer-queue.git"
  },
  "homepage": "https://github.com/IgorGuariroba/pi-steer-queue#readme",
  "files": [
    "extensions/",
    "src/",
    "README.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./extensions/steer-queue.ts"
    ],
    "image": "https://raw.githubusercontent.com/IgorGuariroba/pi-steer-queue/main/docs/images/cover.png"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^1.4.0",
    "@earendil-works/pi-tui": "^1.4.0",
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
